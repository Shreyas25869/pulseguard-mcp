# ========================================================
# PulseGuard MCP Environment Configuration (Optional)
# ========================================================
# Note: If no AWS credentials are provided, PulseGuard MCP
# will automatically run in High-Fidelity Autonomous Emulator mode,
# making it 100% functional out of the box for testing and demos!

PORT=3001

# Optional AWS Credentials for Live Amazon Bedrock / Nova Pro
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Model ID (e.g. anthropic.claude-3-5-sonnet-20241022-v2:0 or amazon.nova-pro-v1:0)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
